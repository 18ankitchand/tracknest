# Example development environment only. Never commit real secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-your-own-long-random-development-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# When Gmail SMTP is configured, set these values outside GitHub
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_HOST_USER=your-sender@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-16-character-app-password
# DJANGO_DEFAULT_FROM_EMAIL=your-sender@gmail.com

# Production PostgreSQL and HTTPS settings come from the hosting provider.
# DATABASE_URL=postgresql://...
